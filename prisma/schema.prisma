// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("ROUTEWISE_DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CatalogProgram {
  id                   String   @id
  country              String
  flag                 String
  region               String
  program              String
  category             String
  tagline              String
  minBudget            Float?
  minMonthlyIncome     Float?
  totalYearOneCost     Float?
  costPerDependent     Float?
  processingWeeks      Float?
  yearsToPR            Float?
  yearsToCitizenship   Float?
  citizenshipLanguage  String?
  jobOfferRequired     Boolean?
  remoteFriendly       Boolean?
  familyFriendly       Float
  passportAccess       String
  devScore             Float
  azEase               Float
  languageBonus        Json
  requirements         Json
  pros                 Json
  cons                 Json
  taxNote              String?
  url                  String
  dvLottery            Boolean  @default(false)
  e2Treaty             Boolean  @default(false)
  verificationStatus   String   @default("unverified")
  verificationSourceUrl String
  checkedAt            DateTime?
  contentHash          String
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  sources              ProgramSource[]
  revisions            ProgramRevision[]
  pathway              Json?
  audit                Json?
  parentId             String?
  parent               CatalogProgram? @relation("PathwayParent",fields:[parentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  children             CatalogProgram[] @relation("PathwayParent")
  splitReceipts        CatalogSplit[]

  @@index([active, country])
  @@index([active, category, region])
  @@index([verificationStatus])
  @@index([minBudget])
  @@index([parentId])
}

model CatalogSplit {
  id                String @id
  parentId          String
  parentContentHash String
  childIds          Json
  appliedAt         DateTime @default(now())
  parent            CatalogProgram @relation(fields:[parentId],references:[id],onDelete:Restrict)
}

model CatalogAudit {
  id           String @id
  manifestHash String
  recordIds    Json
  appliedAt    DateTime @default(now())
}

model ProgramSource {
  id          String   @id @default(cuid())
  programId   String
  url         String
  title       String?
  evidence    String?
  checkedAt   DateTime?
  createdAt   DateTime @default(now())
  program     CatalogProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, url])
}

model ProgramRevision {
  id          String   @id @default(cuid())
  programId   String
  contentHash String
  snapshot    Json
  reason      String
  createdAt   DateTime @default(now())
  program     CatalogProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, createdAt])
}

model SavedProfile {
  id          String   @id
  name        String
  profile     Json
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        StrategyRun[]
}

model StrategyRun {
  id              String   @id @default(cuid())
  profileId       String
  profileVersion  Int
  profileSnapshot Json
  catalogVersion  String
  result          Json
  createdAt       DateTime @default(now())
  profile         SavedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}
